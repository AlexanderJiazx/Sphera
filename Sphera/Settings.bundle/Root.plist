<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Capture Alignment &amp; Auto-Fire</string>
			<key>FooterText</key>
			<string>When auto-fire is on, Sphera captures automatically after holding steady on the target. Enter numeric values for tolerance (3°–15°) and hold duration (0.1s–1.5s).</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Auto-fire capture</string>
			<key>Key</key>
			<string>sphera.autoFireCapture</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSTextFieldSpecifier</string>
			<key>Title</key>
			<string>Alignment tolerance (°)</string>
			<key>Key</key>
			<string>sphera.alignmentToleranceDegrees</string>
			<key>DefaultValue</key>
			<string>6</string>
			<key>KeyboardType</key>
			<string>DecimalPad</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSTextFieldSpecifier</string>
			<key>Title</key>
			<string>Stable hold duration (s)</string>
			<key>Key</key>
			<string>sphera.stableHoldDurationSeconds</string>
			<key>DefaultValue</key>
			<string>0.3</string>
			<key>KeyboardType</key>
			<string>DecimalPad</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Capture preset</string>
			<key>FooterText</key>
			<string>Changes apply the next time a capture session starts. All settings are automatically saved.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSTextFieldSpecifier</string>
			<key>Title</key>
			<string>Horizontal ring (4 – 16)</string>
			<key>Key</key>
			<string>sphera.horizontalCount</string>
			<key>DefaultValue</key>
			<string>8</string>
			<key>KeyboardType</key>
			<string>NumberPad</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSTextFieldSpecifier</string>
			<key>Title</key>
			<string>Downward ring (4 – 8)</string>
			<key>Key</key>
			<string>sphera.downwardCount</string>
			<key>DefaultValue</key>
			<string>5</string>
			<key>KeyboardType</key>
			<string>NumberPad</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSTextFieldSpecifier</string>
			<key>Title</key>
			<string>Upward ring (4 – 8)</string>
			<key>Key</key>
			<string>sphera.upwardCount</string>
			<key>DefaultValue</key>
			<string>5</string>
			<key>KeyboardType</key>
			<string>NumberPad</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>On-device compute</string>
			<key>FooterText</key>
			<string>Off by default. When off, Compute on device uses the stable OpenCV engine. When on, it uses the experimental 3-second Swift/Metal engine (no OpenCV).</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Experimental Metal stitch</string>
			<key>Key</key>
			<string>useExperimentalMetalStitch</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Panorama Viewer</string>
			<key>FooterText</key>
			<string>Screen-Relative (default) rotates horizontally across the screen viewport when looking downward. World-Axis rotates strictly around the global vertical axis like the gyro.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Touch Scroll Mode</string>
			<key>Key</key>
			<string>sphera.viewerScrollMode</string>
			<key>DefaultValue</key>
			<string>screenRelative</string>
			<key>Titles</key>
			<array>
				<string>Screen-Relative (Natural)</string>
				<string>World-Axis (Gyro-Aligned)</string>
			</array>
			<key>Values</key>
			<array>
				<string>screenRelative</string>
				<string>worldAxis</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
